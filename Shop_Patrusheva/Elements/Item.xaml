<UserControl x:Class="Shop_Patrusheva.Elements.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Shop_Patrusheva.Elements"
             mc:Ignorable="d">
    <Grid>
        <Border Margin="20" Width="200" CornerRadius="20" Background="#FF5A5A5A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Image Margin="20" Width="160" Source="/Shop_Patrusheva;component/Images/ic_item.png"/>
                <Label 
                    Name="IName" 
                    Content="Наименование" 
                    Margin="10" 
                    Grid.Row="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Top" 
                    FontWeight="Bold" 
                    Foreground="White"/>
                <Label 
                    Name="IPrice" 
                    Content="Стоимость" 
                    Margin="10,40" 
                    Grid.Row="1"  
                    VerticalAlignment="Top" 
                    Foreground="White"/>
                <Label 
                    Name="ICharackteristic" 
                    Content="Характерситика" 
                    Margin="10,70,10,10" 
                    Grid.Row="1"  
                    VerticalAlignment="Top" 
                    Foreground="White"/>
            </Grid>
            <Border.Effect>
                <DropShadowEffect BlurRadius="3"/>
            </Border.Effect>
            
        </Border>
            
    </Grid>
</UserControl>
